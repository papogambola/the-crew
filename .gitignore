__pycache__/
*.pyc

# Wikipedia pages fetched by tools/anthems.py. A cache, so a re-run costs no requests and
# nobody is rate-limited off the API mid-build; regenerated on demand and never read by the game.
tools/.anthem-cache/

# Generated by tools/skyline-sheet.js from the game itself. Regenerate rather than commit:
# a stale sheet is a picture of a generator that has since changed.
city-skylines.html

# Built artefacts: tools/itch.py writes the itch.io upload here. It is a copy of play.html
# with two variables set, so it is regenerated rather than kept.
build/
